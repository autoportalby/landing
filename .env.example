# --- news feed (admin panel) ---
# Editorial content lives in the admin panel; this site reads it over that API.
# Server-side only — never exposed to the browser.
ADMIN_API_URL="http://localhost:4000"
# Shared with the admin panel: it POSTs here after publishing so the cached feed
# refreshes immediately. Must match LANDING_REVALIDATE_SECRET in the admin's .env.
# openssl rand -hex 32
LANDING_REVALIDATE_SECRET=""

# --- PostgreSQL for Prisma (datasource `db`) ---
# Subscribers and votes only. The news feed no longer comes from this database.
# The admin panel's local Postgres is the same instance (same credentials), so the
# default below works with `pnpm infra:up` in the admin repo.
DATABASE_URL="postgresql://vrum:vrum@localhost:5432/vrum?schema=landing"
# Direct (non-pooled) connection — used for migrations. Local: same as above.
DIRECT_URL="postgresql://vrum:vrum@localhost:5432/vrum?schema=landing"
#
# On Supabase use TWO URLs:
#   DATABASE_URL = pooled  (port 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = direct  (port 5432)
#
# Production (Supabase) — kept alongside the local ones so both work:
#   * Runtime: on Vercel the app uses DATABASE_PROD_URL (pooled). Set the same
#     two vars in the Vercel dashboard (or set DATABASE_URL directly there).
#   * CLI against prod: `npm run db:deploy:prod` / `db:seed:prod` map these onto
#     DATABASE_URL/DIRECT_URL for the Prisma CLI.
DATABASE_PROD_URL=""
DIRECT_PROD_URL=""

# Analytics (optional). Leave unset for dev / pre-launch — nothing loads, no cookies.
# Yandex.Metrika counter id (digits only):
NEXT_PUBLIC_YM_ID=""
# GA4 measurement id (G-XXXXXXX):
NEXT_PUBLIC_GA_ID=""

# PostgreSQL for Prisma (datasource `db`).
# Local docker-compose default (service name `db`, user/password/db = vrum):
DATABASE_URL="postgresql://vrum:vrum@localhost:5432/vrum?schema=public"
# Direct (non-pooled) connection — used for migrations. Local: same as above.
DIRECT_URL="postgresql://vrum:vrum@localhost:5432/vrum?schema=public"
#
# On Supabase use TWO URLs:
#   DATABASE_URL = pooled  (port 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = direct  (port 5432)
#
# Production (Supabase) — kept alongside the local ones so both work:
#   * Runtime: on Vercel the app uses DATABASE_PROD_URL (pooled). Set the same
#     two vars in the Vercel dashboard (or set DATABASE_URL directly there).
#   * CLI against prod: `npm run db:deploy:prod` / `db:seed:prod` map these onto
#     DATABASE_URL/DIRECT_URL for the Prisma CLI.
DATABASE_PROD_URL=""
DIRECT_PROD_URL=""

# Analytics (optional). Leave unset for dev / pre-launch — nothing loads, no cookies.
# Yandex.Metrika counter id (digits only):
NEXT_PUBLIC_YM_ID=""
# GA4 measurement id (G-XXXXXXX):
NEXT_PUBLIC_GA_ID=""
